# Config do Firebase (Console -> Project Settings -> Your apps -> Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=
EXPO_PUBLIC_FIREBASE_IOS_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=
EXPO_PUBLIC_FIREBASE_IOS_APP_ID=

# Web client ID gerado automaticamente ao ativar o provedor Google
# (Firebase Console -> Authentication -> Sign-in method -> Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# URL da API em produção (usada quando o app não está em modo dev)
EXPO_PUBLIC_API_URL=

# Monetizacao desligada: app publicado gratuito, sem paywall.
# So ligue junto com COBRANCA_ATIVA=true no backend.
EXPO_PUBLIC_COBRANCA_ATIVA=false

# Client IDs OAuth do Google, um por plataforma (Google Cloud Console -> Credentials).
# O do Android exige o SHA-1 do certificado de assinatura; sem ele o botao
# de login com Google fica desabilitado nessa plataforma.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
