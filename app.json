{
  "expo": {
    "name": "AgentCicle",
    "slug": "agentcicle",
    "scheme": "agentcicle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agentcicle.app",
      "buildNumber": "1",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.agentcicle.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-logo.png",
        "backgroundColor": "#180B2E"
      },
      "permissions": [
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon-logo.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-video",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#180B2E"
        }
      ]
    ]
  }
}
