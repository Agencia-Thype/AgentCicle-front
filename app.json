{
  "expo": {
    "name": "Cíclica",
    "slug": "ciclica-app",
    "scheme": "agentcicle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.zurve.ciclica",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.zurve.ciclica",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-logo.png",
        "backgroundColor": "#180B2E"
      },
      "permissions": [
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon-logo.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-video",
      "expo-asset",
      "expo-notifications",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#180B2E"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "9da3dd7d-3e71-4865-aabc-ba112bd48517"
      }
    },
    "owner": "zurve-tecnologia"
  }
}
