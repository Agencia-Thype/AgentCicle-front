{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "app/*": [
        "app/*"
      ]
    },
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": [
      "jest",
      "node"
    ]
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ]
}
